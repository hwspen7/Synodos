# Phase 07 runtime options (add these to the backend process environment)
# Periodic saves of confirmed text only; 0 disables, allowed 15-3600 seconds.
MEETING_PHASE07_AUTOSAVE_SECONDS=60
# Recognition remains unchanged until you deliberately configure a model.
# MEETING_ASR_ENGINE=whisper
# MEETING_ASR_MODEL=small
# MEETING_ASR_DEVICE=auto
# MEETING_ASR_LANGUAGE=auto
# Existing /api/metrics endpoint must be enabled via infrastructure settings.
# The model benchmark only loads Whisper/Qwen3 when --infer is explicitly used.
# Optional anti-confusion margin between the two strongest enrolled speaker matches.
# MEETING_PHASE07_SPEAKER_MARGIN=0.03
